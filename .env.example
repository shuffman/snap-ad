ANTHROPIC_API_KEY=your_api_key_here

# Cloudflare Access: the application's AUD tag (Zero Trust → Access → Applications)
CF_ACCESS_AUD=
# Comma-separated emails with unlimited ads; everyone else Access lets in gets FRIEND_DAILY_LIMIT per day
ADMIN_EMAILS=
FRIEND_DAILY_LIMIT=3
# Skip the Access check when running locally (never set this on Railway)
AUTH_DISABLED=1
